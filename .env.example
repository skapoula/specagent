# =============================================================================
# 3GPP SpecAgent Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# API Keys
# -----------------------------------------------------------------------------
# Groq API key - REQUIRED when LLM_PROVIDER=groq (default)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# LLM backend: groq | custom_endpoint | local
LLM_PROVIDER=groq

# Groq model (when LLM_PROVIDER=groq)
# Free-tier limits as of 2025-03:
#   meta-llama/llama-4-scout-17b-16e-instruct : 30 RPM / 30K TPM / 500K TPD (default)
#   llama-3.3-70b-versatile                   : 30 RPM / 12K TPM / 100K TPD
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Max output tokens per Groq call (keep low to stay within free-tier TPM)
GROQ_MAX_TOKENS=1024

# Custom OpenAI-compatible endpoint (when LLM_PROVIDER=custom_endpoint)
CUSTOM_ENDPOINT_URL=http://localhost:8080/v1/chat/completions

# Local GGUF model (when LLM_PROVIDER=local -- not yet implemented)
LLM_MODEL_PATH=/models/qwen3-4b-instruct.Q4_K_M.gguf
LLM_MODEL_NAME=qwen3-4b-instruct

# LLM inference settings
LLM_N_CTX=4096
LLM_N_GPU_LAYERS=0
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# -----------------------------------------------------------------------------
# LanceDB Vector Store
# -----------------------------------------------------------------------------
LANCEDB_URI=data/lancedb
LANCEDB_TABLE_NAME=documents
DEFAULT_LIBRARY=3gpp-specs

# Ingestion
DOCS_DIR=data/docs

# -----------------------------------------------------------------------------
# Embedding Configuration (nomic-embed-text-v1.5, 768d via fastembed, local ONNX)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# -----------------------------------------------------------------------------
# Chunking Configuration (token-based)
# -----------------------------------------------------------------------------
# Target chunk size in tokens
CHUNK_SIZE_TOKENS=512

# Overlap between consecutive chunks (tokens)
CHUNK_OVERLAP_TOKENS=64

# Minimum chunk size (tokens) — smaller chunks are dropped
CHUNK_MIN_TOKENS=50

# -----------------------------------------------------------------------------
# Retrieval Configuration
# -----------------------------------------------------------------------------
# Hybrid BM25+vector search
HYBRID_SEARCH_ENABLED=true
SEARCH_REFINE_FACTOR=10

# Number of chunks to retrieve
RETRIEVAL_TOP_K=10

# Minimum similarity score (0.0-1.0)
SIMILARITY_THRESHOLD=0.3

# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
# Maximum query rewrite attempts
MAX_REWRITES=2

# Minimum confidence to skip rewriting (0.0-1.0)
GRADER_CONFIDENCE_THRESHOLD=0.6

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Phoenix tracing endpoint
PHOENIX_ENDPOINT=http://localhost:6006

# Enable OpenTelemetry tracing
ENABLE_TRACING=true

# -----------------------------------------------------------------------------
# Data Paths
# -----------------------------------------------------------------------------
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
